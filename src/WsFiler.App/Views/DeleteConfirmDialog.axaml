<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WsFiler.App.Views.DeleteConfirmDialog"
        Width="480"
        Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="削除">
    <Grid RowDefinitions="Auto,Auto"
          Margin="16"
          RowSpacing="14">
        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,6,0,0">
            <Button x:Name="YesButton"
                    Content="はい(Y)"
                    Width="120"
                    IsDefault="True"
                    Click="OnYesClick"/>
            <Button Content="いいえ(N)"
                    Width="120"
                    IsCancel="True"
                    Click="OnNoClick"/>
        </StackPanel>
    </Grid>
</Window>
