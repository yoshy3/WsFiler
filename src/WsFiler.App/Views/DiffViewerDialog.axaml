<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WsFiler.App.Views.DiffViewerDialog"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="Compare">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,*,Auto"
              ColumnSpacing="8"
              Margin="8,6">
            <TextBlock x:Name="LeftPathTextBlock"
                       Grid.Column="0"
                       FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="RightPathTextBlock"
                       Grid.Column="1"
                       FontFamily="Consolas"
                       TextTrimming="CharacterEllipsis"/>
            <CheckBox x:Name="DifferencesOnlyCheckBox"
                      Grid.Column="2"
                      VerticalAlignment="Center"
                      Click="OnDifferencesOnlyChanged"/>
        </Grid>

        <ScrollViewer x:Name="RowsScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RowsPanel"
                        HorizontalAlignment="Stretch"
                        Margin="8,0,8,8"/>
        </ScrollViewer>
    </Grid>
</Window>
