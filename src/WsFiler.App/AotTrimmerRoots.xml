<linker>
  <!-- Avalonia XAML compiled binding infrastructure -->
  <assembly fullname="Avalonia.Markup.Xaml" preserve="all" />
  <assembly fullname="Avalonia.Base" preserve="all" />

  <!-- CommunityToolkit.Mvvm source-gen base types -->
  <assembly fullname="CommunityToolkit.Mvvm" preserve="all" />

  <!-- Newtonsoft.Json uses runtime reflection for serialization -->
  <assembly fullname="Newtonsoft.Json" preserve="all" />

  <!-- ViewModels referenced via XAML DataContext bindings -->
  <assembly fullname="WsFiler.Presentation">
    <type fullname="WsFiler.Presentation.ViewModels.*" preserve="all" />
  </assembly>

  <!-- Settings types deserialized by Newtonsoft.Json -->
  <assembly fullname="WsFiler.Infra">
    <type fullname="WsFiler.Infra.Settings.*" preserve="all" />
  </assembly>
</linker>
