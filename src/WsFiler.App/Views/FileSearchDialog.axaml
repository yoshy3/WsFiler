<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WsFiler.App.Views.FileSearchDialog"
        Width="660"
        Height="430"
        MinWidth="560"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Title="File Search">
    <Grid RowDefinitions="Auto,*"
          ColumnDefinitions="*,140"
          Margin="12"
          RowSpacing="8"
          ColumnSpacing="12">
        <Grid Grid.Row="0"
              Grid.Column="0"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="150,*"
              RowSpacing="6"
              ColumnSpacing="8">
            <TextBlock x:Name="PatternLabel"
                       Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="PatternTextBox"
                     Grid.Row="0"
                     Grid.Column="1"/>

            <TextBlock x:Name="BaseDirectoryLabel"
                       Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="BaseDirectoryTextBox"
                     Grid.Row="1"
                     Grid.Column="1"/>

            <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Vertical"
                        Spacing="4">
                <CheckBox x:Name="SearchDirectoriesCheckBox"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Spacing="6">
            <Button x:Name="SearchButton"
                    Height="32"
                    Click="OnSearchClick"/>
            <Button x:Name="JumpButton"
                    Height="32"
                    Click="OnJumpClick"/>
            <Button x:Name="CloseButton"
                    Height="32"
                    IsCancel="True"
                    Click="OnCloseClick"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              RowDefinitions="Auto,*"
              RowSpacing="4">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*">
                <TextBlock x:Name="ResultLabel"
                           Grid.Column="0"/>
                <TextBlock x:Name="ResultCountTextBlock"
                           Grid.Column="1"
                           Margin="20,0,0,0"/>
            </Grid>
            <ListBox x:Name="ResultListBox"
                     Grid.Row="1"
                     FontFamily="Consolas"
                     DoubleTapped="OnResultDoubleTapped"/>
        </Grid>
    </Grid>
</Window>
