<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WsFiler.Presentation.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="WsFiler.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WsFiler">

    <Window.Styles>
        <Style Selector="DataGrid">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="20"/>
            <Setter Property="ColumnHeaderHeight" Value="22"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox.logList">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.logList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ListBox.logList TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
    </Window.Styles>

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Border Grid.Row="0"
                Padding="8,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="WsFiler"
                       FontSize="15"
                       FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              Margin="8"
              ColumnSpacing="8">
            <Border x:Name="LeftPaneBorder"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource SystemAccentColor}"
                    BorderThickness="2"
                    CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="{Binding LeftPane.CurrentPath}"
                               Margin="8,5"
                               FontFamily="Consolas"/>
                    <DataGrid x:Name="LeftFileGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding LeftPane.Items}"
                              SelectedItem="{Binding LeftPane.SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="OnLeftFileGridSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Kind}" Width="24"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="62"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="92"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="178"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border x:Name="RightPaneBorder"
                    Grid.Column="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="{Binding RightPane.CurrentPath}"
                               Margin="8,5"
                               FontFamily="Consolas"/>
                    <DataGrid x:Name="RightFileGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding RightPane.Items}"
                              SelectedItem="{Binding RightPane.SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="OnRightFileGridSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Kind}" Width="24"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="62"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="92"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="178"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                IsVisible="{Binding IsLogVisible}"
                Height="96"
                Padding="8,4"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <ListBox x:Name="LogListBox"
                     Classes="logList"
                     ItemsSource="{Binding Logs}"
                     FontFamily="Consolas"
                     FontSize="12"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="46,70,54,*"
                              MinHeight="18">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Number}"
                                       TextAlignment="Right"
                                       Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TimeText}"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Level}"/>
                            <TextBlock Grid.Column="3"
                                       Text="{Binding Message}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="3"
                Padding="8,6"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusSummary}"
                           FontFamily="Consolas"/>
            </Grid>
        </Border>
    </Grid>

</Window>
