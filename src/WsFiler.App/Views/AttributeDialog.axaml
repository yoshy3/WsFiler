<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WsFiler.App.Views.AttributeDialog"
        Width="320"
        Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Attributes">
    <Grid RowDefinitions="Auto,*,Auto"
          Margin="16"
          RowSpacing="12">
        <TextBlock x:Name="FileNameLabel"
                   Grid.Row="0"
                   TextWrapping="Wrap"/>

        <StackPanel Grid.Row="1"
                    Spacing="8"
                    VerticalAlignment="Center">
            <CheckBox x:Name="ReadOnlyCheckBox"/>
            <CheckBox x:Name="HiddenCheckBox"/>
            <CheckBox x:Name="ArchiveCheckBox"/>
            <CheckBox x:Name="SystemCheckBox"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12">
            <Button x:Name="OkButton"
                    Content="OK"
                    Width="120"
                    IsDefault="True"
                    Click="OnOkClick"/>
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="120"
                    IsCancel="True"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
